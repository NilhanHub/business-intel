# 1BT Business Intel — local-only configuration
# Copy this file to the repository root as .env and replace every <placeholder>.

BT_SHARED_USERNAME=1bt-user
BT_SHARED_PASSWORD_HASH=<paste-a-bcrypt-hash-here>
BT_SESSION_SECRET_KEY=<paste-at-least-32-random-characters-here>

BT_HOST=127.0.0.1
BT_PORT=8080
BT_DEBUG=false
BT_TRUSTED_HOSTS=127.0.0.1,localhost
BT_SESSION_EXPIRE_MINUTES=480
BT_SESSION_COOKIE_SECURE=false

# Optional. The Windows default is %LOCALAPPDATA%\1BT\Business_Intel.
# BT_DATA_DIR=C:\Users\your-user\AppData\Local\1BT\Business_Intel

# Optional. OAuth files default to the external user-data secrets directory.
# BT_SECRETS_DIR=C:\Users\your-user\AppData\Local\1BT\Business_Intel\secrets

# Login and expensive live-refresh throttles.
BT_LOGIN_MAX_ATTEMPTS=5
BT_LOGIN_WINDOW_SECONDS=300
BT_REFRESH_MIN_INTERVAL_SECONDS=30

# Optional ADK integrations must still be configured through local environment
# variables. Do not put API keys or service-account JSON in this example file.
